// Gözdem Burak Turizm — veri modeli
// Not: Yerelde SQLite kullanılıyor (enum desteklemez), bu yüzden durum alanları String.
// Canlıda PostgreSQL'e geçince provider = "postgresql" yeterli.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Acentenin araç filosu. Admin "Otobüslerim" sekmesinden tanımlar; turlar ve
// seferler buradan araç seçer. Koltuk düzeni (sıra, kapı, son sıra) ve plaka
// araçta tutulur — böylece turda birebir doğru şema oluşur ve hatırlatma
// mesajlarında plaka yazılır.
model Bus {
  id           String   @id @default(cuid())
  name         String // tanınması için etiket, örn. "45 Koltuk Mercedes"
  plate        String // 34 ABC 123
  vehicleType  String // OTOBUS | VIP | MINIBUS (koltuk düzenini belirler)
  seatLayout   String // 2+2 | 2+1 | 1+1 (araç tipinden türetilir)
  seatRows     Int
  doorAfterRow Int? // orta kapı bu sıradan sonra (null = kapı yok)
  backRowFull  Boolean  @default(false) // son sırada koridorda da koltuk
  seatMap      String? // serbest koltuk planı (JSON: satır → hücre, hücre = numara ya da "" boşluk). Boşsa eski harfli düzen
  notes        String   @default("")
  active       Boolean  @default(true)
  deletedAt    DateTime? // çöp kutusu (bkz. Tour.deletedAt)
  createdAt    DateTime @default(now())

  tours      Tour[]
  departures TourDeparture[]
}

model Tour {
  id                String    @id @default(cuid())
  slug              String    @unique
  title             String
  destination       String
  category          String // YURT_ICI | YURT_DISI
  bookingType       String // KOLTUK | KONTENJAN
  departureDate     DateTime
  returnDate        DateTime?
  departureLocation String
  durationDays      Int       @default(1)
  price             Int
  currency          String    @default("TRY")
  coverImage        String
  images            String    @default("[]") // JSON dizi
  description       String    @default("")
  highlights        String    @default("[]") // JSON dizi
  documents         String    @default("[]") // tur programı dosyaları (PDF/Word) JSON dizi
  capacity          Int? // KONTENJAN turları için
  // Araç: otobüs seçilirse koltuk düzeni ondan gelir (aşağıdaki alanlar otobüsten
  // kopyalanır). Otobüs seçilmezse alanlar elle girilir (eski turlar böyle).
  busId             String?
  bus               Bus?      @relation(fields: [busId], references: [id])
  vehicleType       String? // OTOBUS | VIP | MINIBUS (KOLTUK turları için)
  seatLayout        String? // 2+2 | 2+1 | 1+1 (araç tipinden türetilir)
  seatRows          Int?
  doorAfterRow      Int? // orta kapı bu sıradan sonra (null = kapı yok)
  backRowFull       Boolean   @default(false) // son sırada koridorda ekstra koltuk
  hasAccommodation  Boolean   @default(false) // konaklamalı tur (oda/kişi fiyatlaması açılır)
  singleSupplement  Int       @default(2000) // tek kişilik konaklanan her oda için eklenen fark
  // --- Ön satış (kapora) ---
  // depositPercent = 0 → ön ödeme kapalı, tur yalnız peşin satılır.
  // >0 ise müşteri "ön ödeme ile rezerve et" seçebilir; kalan tutarın son
  // ödeme tarihi kalkıştan balanceDueDays gün öncesidir.
  depositPercent    Int       @default(0) // kişi başı toplam tur ücretinin yüzdesi (örn. 25)
  balanceDueDays    Int       @default(5) // kalan ödeme için kalkıştan kaç gün önce son tarih
  features          String    @default("[]") // seçili özellik id'leri (JSON dizi)
  excludedFeatures  String    @default("[]") // fiyata dahil OLMAYAN özellik id'leri (JSON dizi)
  status            String    @default("YAYINDA") // TASLAK | YAYINDA
  // Çöp kutusu: silme işareti. Dolu olan kayıt hiçbir listede görünmez ama
  // ilişkileri (seferler, koltuklar, rezervasyonlar) OLDUĞU GİBİ durur —
  // 25 gün içinde geri yüklenebilsin diye. Süre dolunca kalıcı silinir.
  // Filtre tek yerden uygulanıyor: lib/db.ts istemci uzantısı.
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())

  seats      Seat[]
  bookings   Booking[]
  places     TourPlace[]
  departures TourDeparture[]
  waitlist   Waitlist[]
}

// Bir turun ayrı seferi (kalkış/dönüş çifti). Koltuklar ve rezervasyonlar
// sefere bağlıdır; aynı tur birden çok sefer içerebilir (örn. 12'si ve 18'i).
// Tour.departureDate/returnDate en yakın AKTIF seferi yansıtır (liste/sıralama için).
model TourDeparture {
  id            String    @id @default(cuid())
  tourId        String
  tour          Tour      @relation(fields: [tourId], references: [id], onDelete: Cascade)
  departureDate DateTime
  returnDate    DateTime?
  capacity      Int? // KONTENJAN turlarında sefer bazlı kontenjan (boşsa turun kontenjanı)
  busId         String? // bu seferin aracı (boşsa turun varsayılan otobüsü)
  bus           Bus?      @relation(fields: [busId], references: [id])
  status        String    @default("AKTIF") // AKTIF | KAPALI (satışa kapalı)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())

  seats    Seat[]
  bookings Booking[]
  waitlist Waitlist[]

  @@index([tourId, departureDate])
}

model TourPlace {
  id           String  @id @default(cuid())
  tourId       String
  tour         Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  type         String // BINIS (biniş noktası) | GEZI (gezilecek yer) | OTEL (konaklama)
  name         String
  address      String?
  mapQuery     String? // gömme harita için: adres veya "enlem,boylam"
  nights       Int? // OTEL için gece sayısı (opsiyonel)
  price        Int? // BINIS için biniş noktası bazlı kişi başı fiyat (boşsa tur fiyatı)
  boardingTime String? // BINIS için otobüsün o noktada olacağı saat, "HH:MM"
  showOnMap    Boolean @default(true) // GEZI için haritada gösterilsin mi
  sortOrder    Int     @default(0)

  bookings Booking[] // bu noktadan binmeyi seçen rezervasyonlar
}

model Seat {
  id          String         @id @default(cuid())
  tourId      String
  tour        Tour           @relation(fields: [tourId], references: [id], onDelete: Cascade)
  departureId String? // koltuğun ait olduğu sefer (backfill sonrası her zaman dolu)
  departure   TourDeparture? @relation(fields: [departureId], references: [id], onDelete: Cascade)
  code        String
  status      String         @default("BOS") // BOS | KILITLI | SATILDI | BLOKE
  gender      String? // E | K — dolu koltuğun yolcu cinsiyeti (yan yana kuralı için)
  // --- Sepet kilidi -------------------------------------------------------
  // Müşteri koltuğu sepete eklediğinde koltuk KILITLI olur ve bu iki alan
  // dolar: holdToken çerezdeki sepet anahtarı, holdExpiresAt kilidin bitiş
  // anı. Rezervasyon açılınca ikisi de temizlenir ve kilidi
  // Booking.holdExpiresAt devralır.
  //
  // Kilit iki kaynaktan gelebilir ve BU ALANLA ayrışır:
  //   • Sepet kilidi:        KILITLI + holdToken dolu + holdExpiresAt dolu
  //   • Rezervasyon kilidi:  KILITLI + holdToken null  + holdExpiresAt null
  // Süpürme (releaseExpiredHolds) yalnız holdExpiresAt dolu satırlara
  // dokunur; aksi halde ödeme bekleyen rezervasyonların koltukları boşalırdı.
  holdToken     String?
  holdExpiresAt DateTime?

  @@unique([departureId, code])
  @@index([tourId])
  @@index([holdToken])
}

model Booking {
  id                    String         @id @default(cuid())
  tourId                String
  tour                  Tour           @relation(fields: [tourId], references: [id])
  departureId           String? // rezervasyonun ait olduğu sefer (backfill sonrası her zaman dolu)
  departure             TourDeparture? @relation(fields: [departureId], references: [id])
  status                String         @default("BEKLIYOR") // BEKLIYOR | ODENDI | IPTAL | SURE_DOLDU
  totalAmount           Int
  contactName           String
  contactPhone          String
  contactEmail          String
  quantity              Int            @default(1)
  boardingName          String? // yolcunun biniş noktası adı (anlık kopya)
  boardingPlaceId       String? // seçilen biniş noktası (güncel saat için)
  boardingPlace         TourPlace?     @relation(fields: [boardingPlaceId], references: [id])
  paymentMethod         String         @default("ONLINE") // ONLINE | NAKIT | HAVALE | KREDI_KARTI
  accommodationType     String? // SINGLE | MULTI | null (konaklamasız turda null)
  rooms                 String? // oda dağılımı, "2-1-0|1-0-1" (yetişkin-çocuk-bebek)
  paymentRef            String?
  holdExpiresAt         DateTime?
  reminderSentAt        DateTime? // 24s öncesi hatırlatma gönderildi mi
  // --- Tahsilat (ön satış / elden kısmi ödeme) ---
  // totalAmount satışın TOPLAM tutarı; paidAmount bugüne kadar TAHSİL EDİLEN
  // tutar (Collection satırlarının toplamı — tek doğru kaynak oradaki ledger).
  // paidAmount < totalAmount ise rezervasyonun açık bakiyesi var: koltuk
  // ayrılmıştır ama ödeme tamamlanmamıştır. Durum (status) için AYRI bir değer
  // eklenmedi — "ODENDI" rezervasyonun GEÇERLİ olduğunu anlatır; ne kadarının
  // tahsil edildiği para alanlarından okunur. Böylece kontenjan sayımı,
  // koltuk tahtası, hatırlatma ve fatura akışları olduğu gibi çalışır.
  paidAmount            Int            @default(0)
  balanceDueAt          DateTime? // kalan ödemenin son tarihi (ön ödemeli satışta)
  balanceReminderSentAt DateTime? // kalan ödeme hatırlatması gönderildi mi
  // Misafir müşterinin kalan ödemeyi kendi ödeyebilmesi için gizli bağlantı
  // anahtarı (/kalan-odeme/<token>). Rezervasyon id'si yerine ayrı bir sır
  // kullanılır: id e-postalarda ve URL'lerde görünüyor, tahmin edilebilir bir
  // adres üzerinden başkasının rezervasyonu görüntülenmemeli.
  balanceToken          String?        @unique
  userId                String? // giriş yapan müşteri (misafir rezervasyonlarda null)
  user                  User?          @relation(fields: [userId], references: [id])
  loyaltyAwardedAt      DateTime? // sadakat puanı yazıldı mı (idempotent kontrolü)
  // Satın alma öncesi alınan rızalar (KVKK + mesafeli satış / iptal-iade).
  // Rızanın ALINDIĞININ İSPATI için saklanır; geçmiş kayıtlarda null kalır
  // (geriye dönük rıza uydurulmaz). Sürüm lib/consent.ts'teki CONSENT_VERSION.
  consentAcceptedAt     DateTime?
  consentVersion        String?
  consentIp             String?
  // Fatura hangi yolcu adına kesilecek (0 tabanlı sıra). roomIndex ile aynı
  // konvansiyon: yolcular iç içe oluşturulduğu için form aşamasında id yok.
  invoicePassengerIndex Int?
  // Kullanılan indirim kuponu ve düştüğü tutar. totalAmount kupon DÜŞÜLMÜŞ
  // tutardır (müşterinin ödeyeceği para); couponAmount yalnız "ne kadar
  // indirim uygulandı" bilgisini saklar — fatura ve ciro raporları indirimi
  // ayrıca görebilsin.
  couponId              String?        @unique
  coupon                Coupon?        @relation(fields: [couponId], references: [id])
  couponAmount          Int            @default(0)
  // Sahipliğin bu kişiye geçtiği an. Devirde kullanılıyor: bu tarihten SONRA
  // devredilmemiş yolcu kalmadıysa rezervasyonun sahibi de değişir. Zincirleme
  // devirlerde (A→B→C) doğru sonuç vermesi için tarih karşılaştırması şart.
  ownerSince            DateTime?
  createdAt             DateTime       @default(now())

  passengers  Passenger[]
  payments    Payment[]
  collections Collection[]
  invoice     Invoice?
  // Bu rezervasyonDAN yapılan devirler (yolcusu başkasına geçti) ve bu
  // rezervasyonA gelen devirler (başka tura devirde yeni rezervasyon açılır).
  transfersOut BookingTransfer[] @relation("TransferSource")
  transfersIn  BookingTransfer[] @relation("TransferTarget")
}

// Tahsilat kaydı — bir rezervasyon için ALINAN para hareketi.
//
// Neden ayrı tablo: ön satışta para parça parça gelir (önce kapora, sonra
// kalan; elden satışta görevli birkaç kez tahsil eder). Booking üzerinde tek
// bir "ödenen" kolonu tutulsaydı "ne zaman, nasıl, kim aldı" bilgisi kaybolur
// ve yanlış girilen bir tutar geri alınamazdı. paidAmount bu satırların
// toplamından TÜRETİLİR (bkz. lib/collections.ts).
//
// Payment (iyzico) ile karıştırılmamalı: Payment bir ödeme DENEMESİNİN
// sağlayıcı kaydıdır; Collection ise kasaya giren paradır. Online ödemede
// ikisi birlikte oluşur (paymentId ile eşlenir).
model Collection {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount    Int // + tahsilat, - düzeltme/iade (yanlış giren tutarı geri almak için)
  method    String // NAKIT | HAVALE | KREDI_KARTI | ONLINE
  note      String   @default("")
  // İlgili iyzico ödeme kaydı. UNIQUE: callback iki kez gelirse aynı para
  // ikinci kez tahsilat olarak yazılmaz (mükerrer tahsilat koruması).
  paymentId String?  @unique
  createdAt DateTime @default(now())

  @@index([bookingId])
}

model Passenger {
  id          String    @id @default(cuid())
  bookingId   String
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  idNumber    String?
  seatCode    String?
  gender      String?
  birthDate   DateTime?
  nationality String? // TC | FOREIGN
  country     String? // ülke adı (TC ise "Türkiye")
  ageBand     String? // ADULT | CHILD | INFANT (satın alımda bildirilen yaş bandı)
  roomIndex   Int? // konaklamalı turda yolcunun odası (0 tabanlı)
  idDocument  String? // yaş doğrulama için yüklenen kimlik görseli (yolu)
  ageVerified Boolean   @default(false) // admin çocuk/bebek yaşını onayladı mı
}

model Banner {
  id        String    @id @default(cuid())
  deletedAt DateTime? // çöp kutusu (bkz. Tour.deletedAt)
  title     String
  subtitle  String    @default("")
  image     String
  linkUrl   String   @default("")
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AdminUser {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
}

// --- Müşteri kimlik doğrulama (Auth.js / NextAuth) + Sadakat ---
// Not: User/Account/Session/VerificationToken adları Auth.js Prisma adapter'ının
// beklediği STANDART şemadır — değiştirilmemeli. Sadakat alanları User üzerindedir.
// Admin girişleri ayrı (AdminUser) ve bu modellerden bağımsızdır.

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime? // Auth.js standardı — Google ile girişte otomatik dolar
  image          String?
  // özel alanlar
  passwordHash   String? // null => yalnızca Google ile giriş
  phone          String?
  points         Int       @default(0) // güncel puan bakiyesi
  lifetimePoints Int       @default(0) // ömür boyu kazanım (kademe hesabı)
  tier           String    @default("BRONZE") // BRONZE | SILVER | GOLD | PLATINUM
  // Üyelik aktif mi. Admin "pasife al" dediğinde false olur: üye giriş yapamaz
  // ve açık oturumu da düşer (bkz. lib/session.ts), ama rezervasyon geçmişi,
  // puanı ve faturaları OLDUĞU GİBİ kalır. Kalıcı silme ayrı bir işlemdir.
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  accounts        Account[]
  sessions        Session[]
  bookings        Booking[]
  pointsLog       PointsLedger[]
  savedPassengers SavedPassenger[]
  waitlist        Waitlist[]
  coupons         Coupon[]
  transfersOut    BookingTransfer[] @relation("TransfersFrom")
  transfersIn     BookingTransfer[] @relation("TransfersTo")
}

// Yedek liste kaydı — otobüs/kontenjan DOLUYKEN alınan koltuksuz talep.
//
// Neden Booking üzerinde bir durum değil de ayrı tablo: bu bir rezervasyon
// DEĞİLDİR. Koltuk ayrılmaz, para alınmaz, kontenjan/ciro/koltuk tahtası
// sayımlarına girmez. Booking'e "YEDEK" gibi bir durum eklenseydi status
// filtreleyen her yerin (ciro, kontenjan, hatırlatmalar, Excel çıktısı, fatura)
// onu dışlamayı öğrenmesi gerekirdi.
//
// Amaç: dolu seferde talep kaybedilmesin. Yeterli talep birikirse 2. otobüs
// temin edilir; ya da 1. otobüsten bir iptal çıkınca bekleyen oraya
// yerleştirilir; ya da bekleyen farklı bir sefere taşınır. Yerleştirme kararı
// ACENTENİN — otomatik bildirim ya da otomatik yerleştirme YOK.
model Waitlist {
  id          String         @id @default(cuid())
  tourId      String
  tour        Tour           @relation(fields: [tourId], references: [id], onDelete: Cascade)
  departureId String? // hangi sefer için bekliyor (sefersiz turda null)
  departure   TourDeparture? @relation(fields: [departureId], references: [id], onDelete: Cascade)

  contactName  String
  contactPhone String
  contactEmail String
  quantity     Int    @default(1) // kaç kişi için bekliyor
  note         String @default("") // müşterinin notu
  userId       String? // giriş yapmış müşteriyse hesabı
  user         User?   @relation(fields: [userId], references: [id])

  status      String    @default("BEKLIYOR") // BEKLIYOR | DONUSTURULDU | IPTAL
  bookingId   String? // DONUSTURULDU ise oluşan rezervasyon
  handledAt   DateTime? // işleme alındığı an (dönüşüm ya da iptal)
  handledNote String    @default("") // görevli notu
  createdAt   DateTime  @default(now())

  @@index([departureId, status])
  @@index([tourId])
}

// Müşterinin hesabına kaydettiği yolcu bilgisi (kendisi ve yakınları).
// Amaç: her rezervasyonda TC kimlik no / doğum tarihi gibi alanları yeniden
// girmek zorunda kalmamak — satın alma formunda listeden seçilip doldurulur.
//
// KVKK: kayıt OPT-IN'dir (müşteri satın alma formunda ya da Kişilerim
// sayfasında açıkça kaydeder) ve Kişilerim sayfasından silinebilir. Rezervasyonun
// kendi Passenger kaydı bundan BAĞIMSIZDIR: buradaki kayıt silinince geçmiş
// rezervasyon etkilenmez (yolcu listesi, bilet ve fatura olduğu gibi kalır).
model SavedPassenger {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  idNumber    String? // TC kimlik no veya pasaport no
  birthDate   DateTime? // yaş indirimi bundan hesaplanır
  gender      String? // E | K
  nationality String    @default("TC") // TC | FOREIGN
  country     String? // yabancı uyruklu ise ülke adı
  label       String    @default("") // müşterinin kendi notu: "Eşim", "Oğlum"…
  isSelf      Boolean   @default(false) // "Ben" kaydı — listede en üstte gösterilir
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String // amaç:eposta (örn. "verify:ali@x.com" / "reset:ali@x.com")
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Sadakat puan hareketleri (kazanım / hoşgeldin / düzeltme).
model PointsLedger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId String? // kaynağı olan rezervasyon (opsiyonel)
  delta     Int // +kazanım / -harcama
  reason    String // KAZANIM | HOSGELDIN | DUZELTME | IPTAL | KUPON | KUPON_IPTAL
  note      String   @default("")
  createdAt DateTime @default(now())
}

// Rezervasyon devri — bir yolcunun yerini başka kişiye bırakması.
//
// Neden ayrı tablo ve yeni bir Booking.status DEĞİL: devredilen rezervasyon
// hâlâ GEÇERLİ ve ödenmiş bir rezervasyondur, yalnız yolcusu (ve bazen sahibi)
// değişir. "DEVREDILDI" gibi bir durum eklenseydi status filtreleyen her yerin
// (ciro, kontenjan, koltuk tahtası, hatırlatma, Excel, fatura) onu öğrenmesi
// gerekirdi.
//
// İki devir biçimi var:
//   • AYNI tura devir: yolcu satırı yerinde güncellenir, koltuk korunur.
//     targetBookingId boş kalır.
//   • BAŞKA tura devir: hedef turda YENİ rezervasyon açılır, yolcu oraya
//     taşınır ve kaynak rezervasyondaki yeri boşaltılır. Fiyat farkı
//     priceDifference'a yazılır: artı = müşteri borçlu, eksi = iade edilecek.
model BookingTransfer {
  id        String  @id @default(cuid())
  bookingId String // devrin yapıldığı (kaynak) rezervasyon
  booking   Booking @relation("TransferSource", fields: [bookingId], references: [id], onDelete: Cascade)

  // BAŞKA tura devirde oluşan yeni rezervasyon (aynı tura devirde null).
  targetBookingId String?
  targetBooking   Booking? @relation("TransferTarget", fields: [targetBookingId], references: [id])

  passengerId String? // devredilen yolcu satırı
  seatCode    String? // devir anındaki koltuk (anlık kopya)

  // Devreden — yolcu satırı artık yeni kişiyi tuttuğu için kimlik buraya kopyalanır.
  fromFirstName String
  fromLastName  String
  fromIdNumber  String?
  fromEmail     String
  fromUserId    String?
  fromUser      User?   @relation("TransfersFrom", fields: [fromUserId], references: [id])

  // Devredilen kişi
  toFirstName String
  toLastName  String
  toEmail     String
  toPhone     String
  toUserId    String?
  toUser      User?   @relation("TransfersTo", fields: [toUserId], references: [id])

  // Fiyat farkı (kuruşsuz TL). + = müşteri EK ÖDEME yapacak (borç),
  // - = müşteriye İADE edilecek, 0 = fark yok. Aynı tura devirde her zaman 0
  // (aynı yaş bandı şartı tutarı değiştirmiyor).
  priceDifference Int    @default(0)
  // Fark nasıl kapandı: YOK | BEKLIYOR | ODENDI | IADE_BEKLIYOR | IADE_EDILDI
  differenceStatus String @default("YOK")
  // Borç ödemesi için müşteriye verilen gizli bağlantı anahtarı.
  differenceToken  String? @unique

  actor          String // MUSTERI | ADMIN
  actorEmail     String
  ownershipMoved Boolean @default(false)
  note           String  @default("")
  createdAt      DateTime @default(now())

  @@index([bookingId])
  @@index([fromUserId])
  @@index([targetBookingId])
}

// İndirim kuponu — ödemede girilerek tutardan düşülen TL değeri.
//
// İki yoldan doğar:
//   • Müşteri puanını çevirir (POINTS_PER_LIRA puan = 1 ₺). Çevrilen puan
//     anında düşülür ve PointsLedger'a "KUPON" satırı yazılır; kupon iptal
//     edilirse puan geri yüklenir ("KUPON_IPTAL").
//   • Admin elle oluşturur (kampanya, özür, telefonla verilen indirim).
//     Bu durumda pointsSpent = 0 ve userId boş bırakılabilir.
//
// Tek kullanımlıktır: bir rezervasyonda kullanılır, artan kısım YANAR (para
// üstü verilmez) — müşteri kullanmadan önce uyarılır.
model Coupon {
  id     String @id @default(cuid())
  // Müşterinin gireceği kod. Okunması kolay olsun diye büyük harf + rakam,
  // karıştırılan karakterler (0/O, 1/I) üretimde dışarıda bırakılır.
  code   String @unique
  amount Int // kuponun TL değeri

  // Sahibi. Puan karşılığı üretilen kuponda zorunlu; admin kampanya
  // kuponunda boş olabilir (kodu bilen herkes kullanır).
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  pointsSpent Int    @default(0) // karşılığında düşülen puan (admin kuponunda 0)
  status      String @default("AKTIF") // AKTIF | KULLANILDI | IPTAL | SURE_DOLDU
  note        String @default("") // admin notu / kampanya adı

  usedAt    DateTime?
  expiresAt DateTime? // boşsa süresiz
  createdBy String    @default("MUSTERI") // MUSTERI | ADMIN
  createdAt DateTime  @default(now())

  booking Booking?

  @@index([userId, status])
}

// Tura eklenebilecek özellik/hizmet (Konaklama, Kahvaltı, Rehber…). Admin panelden yönetilir.
model Amenity {
  id        String    @id @default(cuid())
  name      String
  icon      String    @default("") // emoji, örn. "🍳" (opsiyonel)
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  deletedAt DateTime? // çöp kutusu (bkz. Tour.deletedAt)
  createdAt DateTime  @default(now())
}

// "Tatil & Otel" bize ulaşın formundan gelen talep. Sadece iletişim bilgisi
// alınır; teklif/rezervasyon süreci telefonla yürütülür. E-posta gönderimi
// başarısız olsa bile talebin kaybolmaması için veritabanına da yazılır.
model HotelInquiry {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  phone     String
  note      String   @default("") // müşterinin eklediği serbest not (opsiyonel)
  status    String   @default("YENI") // YENI | ARANDI
  emailSent Boolean  @default(false) // acenteye bildirim e-postası gitti mi
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  author    String
  rating    Int      @default(5) // 1-5
  text      String
  location  String? // örn. "Kapadokya Turu" veya şehir
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// iyzico ödeme denemesi kaydı. Her ödeme başlatma bir satır açar, callback
// aynı satırı günceller. Amacı mutabakat ve uyuşmazlık takibi: "bu rezervasyon
// için iyzico ne dedi?" sorusunun cevabı burada durur.
// Kart verisi TUTULMAZ — yalnızca iyzico'nun döndürdüğü maskeli özet
// (kart ailesi, son 4 hane) saklanır.
model Payment {
  id           String    @id @default(cuid())
  bookingId    String
  booking      Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider     String    @default("IYZICO")
  token        String?   @unique // checkout form token'ı (callback eşlemesi)
  paymentId    String? // iyzico ödeme kimliği (iade için gerekli)
  status       String    @default("BASLATILDI") // BASLATILDI | BASARILI | BASARISIZ | IADE
  amount       Int // bizim beklediğimiz tutar (Booking.totalAmount kopyası)
  paidAmount   Int? // iyzico'nun tahsil ettiği tutar (taksitte komisyonla farklı olabilir)
  currency     String    @default("TRY")
  installment  Int? // taksit sayısı (1 = tek çekim)
  cardFamily   String? // örn. "Bonus"
  cardLastFour String? // son 4 hane — iyzico'dan geldiği gibi
  fraudStatus  Int? // 1 onaylı | 0 incelemede | -1 reddedildi
  errorCode    String?
  errorMessage String?
  refundedAt   DateTime?
  refundRef    String? // iyzico iade referansı
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([bookingId])
}

// Kayıtlı Excel sütun şablonu. Görevli "otel listesi" gibi bir sütun kümesini
// bir kez seçip adlandırır; sonraki dışa aktarımlarda o şablonu seçmesi yeter.
// Acente küçük olduğu için şablonlar tüm görevliler arasında ortaktır.
model ExcelTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  columns   String // seçili sütun anahtarları, JSON dizi (lib/excel-columns.ts)
  createdAt DateTime @default(now())
}

// Kesilen/kesilecek fatura kaydı. Payment modeliyle aynı mantık: deneme ve
// sonucu Booking'e kolon olarak değil kendi tablosunda tutulur, böylece ara
// durumlar (fatura kesildi ama e-Arşiv gönderilemedi) temsil edilebilir.
model Invoice {
  id           String    @id @default(cuid())
  bookingId    String    @unique // mükerrer faturaya DB seviyesinde engel
  booking      Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider     String    @default("PARASUT")
  contactId    String? // Paraşüt cari id
  invoiceId    String? // Paraşüt sales_invoice id — oluşur oluşmaz yazılır
  eArchiveId   String? // Paraşüt e_archive id
  status       String    @default("BEKLIYOR") // BEKLIYOR | ISLENIYOR | KESILDI | GONDERILDI | BASARISIZ | ELLE
  attempts     Int       @default(0)
  errorMessage String?
  emailSentAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
