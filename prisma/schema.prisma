// Gözdem Burak Turizm — veri modeli
// Not: Yerelde SQLite kullanılıyor (enum desteklemez), bu yüzden durum alanları String.
// Canlıda PostgreSQL'e geçince provider = "postgresql" yeterli.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Tour {
  id                String    @id @default(cuid())
  slug              String    @unique
  title             String
  destination       String
  category          String // YURT_ICI | YURT_DISI
  bookingType       String // KOLTUK | KONTENJAN
  departureDate     DateTime
  returnDate        DateTime?
  departureLocation String
  durationDays      Int       @default(1)
  price             Int
  currency          String    @default("TRY")
  coverImage        String
  images            String    @default("[]") // JSON dizi
  description       String    @default("")
  highlights        String    @default("[]") // JSON dizi
  capacity          Int? // KONTENJAN turları için
  vehicleType       String? // OTOBUS | VIP | MINIBUS (KOLTUK turları için)
  seatLayout        String? // 2+2 | 2+1 | 1+1 (araç tipinden türetilir)
  seatRows          Int?
  doorAfterRow      Int? // orta kapı bu sıradan sonra (null = kapı yok)
  backRowFull       Boolean   @default(false) // son sırada koridorda ekstra koltuk
  singleSupplement  Int       @default(2000) // tek kişilik konaklama farkı
  features          String    @default("[]") // seçili özellik id'leri (JSON dizi)
  excludedFeatures  String    @default("[]") // fiyata dahil OLMAYAN özellik id'leri (JSON dizi)
  status            String    @default("YAYINDA") // TASLAK | YAYINDA
  createdAt         DateTime  @default(now())

  seats    Seat[]
  bookings Booking[]
  places   TourPlace[]
}

model TourPlace {
  id        String  @id @default(cuid())
  tourId    String
  tour      Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  type      String // DURAK | OTEL
  name      String
  address   String?
  mapQuery  String? // gömme harita için: adres veya "enlem,boylam"
  nights    Int? // OTEL için gece sayısı (opsiyonel)
  price     Int? // DURAK için biniş noktası bazlı kişi başı fiyat (opsiyonel; boşsa tur fiyatı)
  sortOrder Int     @default(0)
}

model Seat {
  id     String  @id @default(cuid())
  tourId String
  tour   Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  code   String
  status String  @default("BOS") // BOS | KILITLI | SATILDI
  gender String? // E | K — dolu koltuğun yolcu cinsiyeti (yan yana kuralı için)

  @@unique([tourId, code])
}

model Booking {
  id            String    @id @default(cuid())
  tourId        String
  tour          Tour      @relation(fields: [tourId], references: [id])
  status        String    @default("BEKLIYOR") // BEKLIYOR | ODENDI | IPTAL | SURE_DOLDU
  totalAmount   Int
  contactName   String
  contactPhone  String
  contactEmail  String
  quantity      Int       @default(1)
  boardingName   String?   // yolcunun binis noktasi (secilen DURAK adi)
  paymentMethod  String    @default("ONLINE") // ONLINE | NAKIT
  accommodationType String? // SINGLE | MULTI | null (konaklamasız turda null)
  paymentRef     String?
  holdExpiresAt  DateTime?
  reminderSentAt DateTime? // 24s öncesi hatırlatma gönderildi mi
  userId           String?   // giriş yapan müşteri (misafir rezervasyonlarda null)
  user             User?     @relation(fields: [userId], references: [id])
  loyaltyAwardedAt DateTime? // sadakat puanı yazıldı mı (idempotent kontrolü)
  createdAt      DateTime  @default(now())

  passengers Passenger[]
}

model Passenger {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  idNumber  String?
  seatCode  String?
  gender    String?
  birthDate   DateTime?
  nationality String?   // TC | FOREIGN
  country     String?   // ülke adı (TC ise "Türkiye")
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String   @default("")
  image     String
  linkUrl   String   @default("")
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AdminUser {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
}

// --- Müşteri kimlik doğrulama (Auth.js / NextAuth) + Sadakat ---
// Not: User/Account/Session/VerificationToken adları Auth.js Prisma adapter'ının
// beklediği STANDART şemadır — değiştirilmemeli. Sadakat alanları User üzerindedir.
// Admin girişleri ayrı (AdminUser) ve bu modellerden bağımsızdır.

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime? // Auth.js standardı — Google ile girişte otomatik dolar
  image          String?
  // özel alanlar
  passwordHash   String? // null => yalnızca Google ile giriş
  phone          String?
  points         Int       @default(0) // güncel puan bakiyesi
  lifetimePoints Int       @default(0) // ömür boyu kazanım (kademe hesabı)
  tier           String    @default("BRONZE") // BRONZE | SILVER | GOLD | PLATINUM
  createdAt      DateTime  @default(now())

  accounts  Account[]
  sessions  Session[]
  bookings  Booking[]
  pointsLog PointsLedger[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String // amaç:eposta (örn. "verify:ali@x.com" / "reset:ali@x.com")
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Sadakat puan hareketleri (kazanım / hoşgeldin / düzeltme).
model PointsLedger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId String? // kaynağı olan rezervasyon (opsiyonel)
  delta     Int // +kazanım / -harcama
  reason    String // KAZANIM | HOSGELDIN | DUZELTME
  note      String   @default("")
  createdAt DateTime @default(now())
}

// Tura eklenebilecek özellik/hizmet (Konaklama, Kahvaltı, Rehber…). Admin panelden yönetilir.
model Amenity {
  id        String   @id @default(cuid())
  name      String
  icon      String   @default("") // emoji, örn. "🍳" (opsiyonel)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  author    String
  rating    Int      @default(5) // 1-5
  text      String
  location  String? // örn. "Kapadokya Turu" veya şehir
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}
