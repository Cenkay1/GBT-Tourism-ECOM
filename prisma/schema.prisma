// Gözdem Burak Turizm — veri modeli
// Not: Yerelde SQLite kullanılıyor (enum desteklemez), bu yüzden durum alanları String.
// Canlıda PostgreSQL'e geçince provider = "postgresql" yeterli.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Acentenin araç filosu. Admin "Otobüslerim" sekmesinden tanımlar; turlar ve
// seferler buradan araç seçer. Koltuk düzeni (sıra, kapı, son sıra) ve plaka
// araçta tutulur — böylece turda birebir doğru şema oluşur ve hatırlatma
// mesajlarında plaka yazılır.
model Bus {
  id           String   @id @default(cuid())
  name         String // tanınması için etiket, örn. "45 Koltuk Mercedes"
  plate        String // 34 ABC 123
  vehicleType  String // OTOBUS | VIP | MINIBUS (koltuk düzenini belirler)
  seatLayout   String // 2+2 | 2+1 | 1+1 (araç tipinden türetilir)
  seatRows     Int
  doorAfterRow Int? // orta kapı bu sıradan sonra (null = kapı yok)
  backRowFull  Boolean  @default(false) // son sırada koridorda da koltuk
  seatMap      String? // serbest koltuk planı (JSON: satır → hücre, hücre = numara ya da "" boşluk). Boşsa eski harfli düzen
  notes        String   @default("")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  tours      Tour[]
  departures TourDeparture[]
}

model Tour {
  id                String    @id @default(cuid())
  slug              String    @unique
  title             String
  destination       String
  category          String // YURT_ICI | YURT_DISI
  bookingType       String // KOLTUK | KONTENJAN
  departureDate     DateTime
  returnDate        DateTime?
  departureLocation String
  durationDays      Int       @default(1)
  price             Int
  currency          String    @default("TRY")
  coverImage        String
  images            String    @default("[]") // JSON dizi
  description       String    @default("")
  highlights        String    @default("[]") // JSON dizi
  documents         String    @default("[]") // tur programı dosyaları (PDF/Word) JSON dizi
  capacity          Int? // KONTENJAN turları için
  // Araç: otobüs seçilirse koltuk düzeni ondan gelir (aşağıdaki alanlar otobüsten
  // kopyalanır). Otobüs seçilmezse alanlar elle girilir (eski turlar böyle).
  busId             String?
  bus               Bus?      @relation(fields: [busId], references: [id])
  vehicleType       String? // OTOBUS | VIP | MINIBUS (KOLTUK turları için)
  seatLayout        String? // 2+2 | 2+1 | 1+1 (araç tipinden türetilir)
  seatRows          Int?
  doorAfterRow      Int? // orta kapı bu sıradan sonra (null = kapı yok)
  backRowFull       Boolean   @default(false) // son sırada koridorda ekstra koltuk
  hasAccommodation  Boolean   @default(false) // konaklamalı tur (oda/kişi fiyatlaması açılır)
  singleSupplement  Int       @default(2000) // tek kişilik konaklanan her oda için eklenen fark
  features          String    @default("[]") // seçili özellik id'leri (JSON dizi)
  excludedFeatures  String    @default("[]") // fiyata dahil OLMAYAN özellik id'leri (JSON dizi)
  status            String    @default("YAYINDA") // TASLAK | YAYINDA
  createdAt         DateTime  @default(now())

  seats      Seat[]
  bookings   Booking[]
  places     TourPlace[]
  departures TourDeparture[]
}

// Bir turun ayrı seferi (kalkış/dönüş çifti). Koltuklar ve rezervasyonlar
// sefere bağlıdır; aynı tur birden çok sefer içerebilir (örn. 12'si ve 18'i).
// Tour.departureDate/returnDate en yakın AKTIF seferi yansıtır (liste/sıralama için).
model TourDeparture {
  id            String    @id @default(cuid())
  tourId        String
  tour          Tour      @relation(fields: [tourId], references: [id], onDelete: Cascade)
  departureDate DateTime
  returnDate    DateTime?
  capacity      Int? // KONTENJAN turlarında sefer bazlı kontenjan (boşsa turun kontenjanı)
  busId         String? // bu seferin aracı (boşsa turun varsayılan otobüsü)
  bus           Bus?      @relation(fields: [busId], references: [id])
  status        String    @default("AKTIF") // AKTIF | KAPALI (satışa kapalı)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())

  seats    Seat[]
  bookings Booking[]

  @@index([tourId, departureDate])
}

model TourPlace {
  id           String  @id @default(cuid())
  tourId       String
  tour         Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  type         String // BINIS (biniş noktası) | GEZI (gezilecek yer) | OTEL (konaklama)
  name         String
  address      String?
  mapQuery     String? // gömme harita için: adres veya "enlem,boylam"
  nights       Int? // OTEL için gece sayısı (opsiyonel)
  price        Int? // BINIS için biniş noktası bazlı kişi başı fiyat (boşsa tur fiyatı)
  boardingTime String? // BINIS için otobüsün o noktada olacağı saat, "HH:MM"
  showOnMap    Boolean @default(true) // GEZI için haritada gösterilsin mi
  sortOrder    Int     @default(0)

  bookings Booking[] // bu noktadan binmeyi seçen rezervasyonlar
}

model Seat {
  id          String         @id @default(cuid())
  tourId      String
  tour        Tour           @relation(fields: [tourId], references: [id], onDelete: Cascade)
  departureId String? // koltuğun ait olduğu sefer (backfill sonrası her zaman dolu)
  departure   TourDeparture? @relation(fields: [departureId], references: [id], onDelete: Cascade)
  code        String
  status      String         @default("BOS") // BOS | KILITLI | SATILDI | BLOKE
  gender      String? // E | K — dolu koltuğun yolcu cinsiyeti (yan yana kuralı için)

  @@unique([departureId, code])
  @@index([tourId])
}

model Booking {
  id                    String         @id @default(cuid())
  tourId                String
  tour                  Tour           @relation(fields: [tourId], references: [id])
  departureId           String? // rezervasyonun ait olduğu sefer (backfill sonrası her zaman dolu)
  departure             TourDeparture? @relation(fields: [departureId], references: [id])
  status                String         @default("BEKLIYOR") // BEKLIYOR | ODENDI | IPTAL | SURE_DOLDU
  totalAmount           Int
  contactName           String
  contactPhone          String
  contactEmail          String
  quantity              Int            @default(1)
  boardingName          String? // yolcunun biniş noktası adı (anlık kopya)
  boardingPlaceId       String? // seçilen biniş noktası (güncel saat için)
  boardingPlace         TourPlace?     @relation(fields: [boardingPlaceId], references: [id])
  paymentMethod         String         @default("ONLINE") // ONLINE | NAKIT | HAVALE | KREDI_KARTI
  accommodationType     String? // SINGLE | MULTI | null (konaklamasız turda null)
  rooms                 String? // oda dağılımı, "2-1-0|1-0-1" (yetişkin-çocuk-bebek)
  paymentRef            String?
  holdExpiresAt         DateTime?
  reminderSentAt        DateTime? // 24s öncesi hatırlatma gönderildi mi
  userId                String? // giriş yapan müşteri (misafir rezervasyonlarda null)
  user                  User?          @relation(fields: [userId], references: [id])
  loyaltyAwardedAt      DateTime? // sadakat puanı yazıldı mı (idempotent kontrolü)
  // Satın alma öncesi alınan rızalar (KVKK + mesafeli satış / iptal-iade).
  // Rızanın ALINDIĞININ İSPATI için saklanır; geçmiş kayıtlarda null kalır
  // (geriye dönük rıza uydurulmaz). Sürüm lib/consent.ts'teki CONSENT_VERSION.
  consentAcceptedAt     DateTime?
  consentVersion        String?
  consentIp             String?
  // Fatura hangi yolcu adına kesilecek (0 tabanlı sıra). roomIndex ile aynı
  // konvansiyon: yolcular iç içe oluşturulduğu için form aşamasında id yok.
  invoicePassengerIndex Int?
  createdAt             DateTime       @default(now())

  passengers Passenger[]
  payments   Payment[]
  invoice    Invoice?
}

model Passenger {
  id          String    @id @default(cuid())
  bookingId   String
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  idNumber    String?
  seatCode    String?
  gender      String?
  birthDate   DateTime?
  nationality String? // TC | FOREIGN
  country     String? // ülke adı (TC ise "Türkiye")
  ageBand     String? // ADULT | CHILD | INFANT (satın alımda bildirilen yaş bandı)
  roomIndex   Int? // konaklamalı turda yolcunun odası (0 tabanlı)
  idDocument  String? // yaş doğrulama için yüklenen kimlik görseli (yolu)
  ageVerified Boolean   @default(false) // admin çocuk/bebek yaşını onayladı mı
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String   @default("")
  image     String
  linkUrl   String   @default("")
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AdminUser {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
}

// --- Müşteri kimlik doğrulama (Auth.js / NextAuth) + Sadakat ---
// Not: User/Account/Session/VerificationToken adları Auth.js Prisma adapter'ının
// beklediği STANDART şemadır — değiştirilmemeli. Sadakat alanları User üzerindedir.
// Admin girişleri ayrı (AdminUser) ve bu modellerden bağımsızdır.

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime? // Auth.js standardı — Google ile girişte otomatik dolar
  image          String?
  // özel alanlar
  passwordHash   String? // null => yalnızca Google ile giriş
  phone          String?
  points         Int       @default(0) // güncel puan bakiyesi
  lifetimePoints Int       @default(0) // ömür boyu kazanım (kademe hesabı)
  tier           String    @default("BRONZE") // BRONZE | SILVER | GOLD | PLATINUM
  createdAt      DateTime  @default(now())

  accounts  Account[]
  sessions  Session[]
  bookings  Booking[]
  pointsLog PointsLedger[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String // amaç:eposta (örn. "verify:ali@x.com" / "reset:ali@x.com")
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Sadakat puan hareketleri (kazanım / hoşgeldin / düzeltme).
model PointsLedger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId String? // kaynağı olan rezervasyon (opsiyonel)
  delta     Int // +kazanım / -harcama
  reason    String // KAZANIM | HOSGELDIN | DUZELTME | IPTAL
  note      String   @default("")
  createdAt DateTime @default(now())
}

// Tura eklenebilecek özellik/hizmet (Konaklama, Kahvaltı, Rehber…). Admin panelden yönetilir.
model Amenity {
  id        String   @id @default(cuid())
  name      String
  icon      String   @default("") // emoji, örn. "🍳" (opsiyonel)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  author    String
  rating    Int      @default(5) // 1-5
  text      String
  location  String? // örn. "Kapadokya Turu" veya şehir
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// iyzico ödeme denemesi kaydı. Her ödeme başlatma bir satır açar, callback
// aynı satırı günceller. Amacı mutabakat ve uyuşmazlık takibi: "bu rezervasyon
// için iyzico ne dedi?" sorusunun cevabı burada durur.
// Kart verisi TUTULMAZ — yalnızca iyzico'nun döndürdüğü maskeli özet
// (kart ailesi, son 4 hane) saklanır.
model Payment {
  id           String    @id @default(cuid())
  bookingId    String
  booking      Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider     String    @default("IYZICO")
  token        String?   @unique // checkout form token'ı (callback eşlemesi)
  paymentId    String? // iyzico ödeme kimliği (iade için gerekli)
  status       String    @default("BASLATILDI") // BASLATILDI | BASARILI | BASARISIZ | IADE
  amount       Int // bizim beklediğimiz tutar (Booking.totalAmount kopyası)
  paidAmount   Int? // iyzico'nun tahsil ettiği tutar (taksitte komisyonla farklı olabilir)
  currency     String    @default("TRY")
  installment  Int? // taksit sayısı (1 = tek çekim)
  cardFamily   String? // örn. "Bonus"
  cardLastFour String? // son 4 hane — iyzico'dan geldiği gibi
  fraudStatus  Int? // 1 onaylı | 0 incelemede | -1 reddedildi
  errorCode    String?
  errorMessage String?
  refundedAt   DateTime?
  refundRef    String? // iyzico iade referansı
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([bookingId])
}

// Kayıtlı Excel sütun şablonu. Görevli "otel listesi" gibi bir sütun kümesini
// bir kez seçip adlandırır; sonraki dışa aktarımlarda o şablonu seçmesi yeter.
// Acente küçük olduğu için şablonlar tüm görevliler arasında ortaktır.
model ExcelTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  columns   String // seçili sütun anahtarları, JSON dizi (lib/excel-columns.ts)
  createdAt DateTime @default(now())
}

// Kesilen/kesilecek fatura kaydı. Payment modeliyle aynı mantık: deneme ve
// sonucu Booking'e kolon olarak değil kendi tablosunda tutulur, böylece ara
// durumlar (fatura kesildi ama e-Arşiv gönderilemedi) temsil edilebilir.
model Invoice {
  id           String    @id @default(cuid())
  bookingId    String    @unique // mükerrer faturaya DB seviyesinde engel
  booking      Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider     String    @default("PARASUT")
  contactId    String? // Paraşüt cari id
  invoiceId    String? // Paraşüt sales_invoice id — oluşur oluşmaz yazılır
  eArchiveId   String? // Paraşüt e_archive id
  status       String    @default("BEKLIYOR") // BEKLIYOR | ISLENIYOR | KESILDI | GONDERILDI | BASARISIZ | ELLE
  attempts     Int       @default(0)
  errorMessage String?
  emailSentAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
